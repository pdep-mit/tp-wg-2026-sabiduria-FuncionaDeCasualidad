import defensas.*
import zombies.*
import mapa.*
import pesos.*


describe "Verdulero - lógica de dominio" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const verdulero = new Verdulero(
    position = game.at(2, 3),
    vida = 50,
    costo = 10,
    danio = 20,
    mapa = mapaDeTest,
    intervaloDeColocacion = 5,
    intervaloDeAccion = 10
  )

  test "recibir daño reduce la vida" {
    verdulero.recibirDanio(15)
    assert.equals(35, verdulero.vida())
  }

  test "recibir daño múltiple acumula la reducción" {
    verdulero.recibirDanio(10)
    verdulero.recibirDanio(10)
    assert.equals(30, verdulero.vida())
  }

  test "muere cuando su vida llega a 0" {
    verdulero.recibirDanio(50)
    assert.that(verdulero.estaMuerto())
  }

  test "muere cuando su vida queda negativa" {
    verdulero.recibirDanio(999)
    assert.that(verdulero.estaMuerto())
  }

  test "no está muerta si tiene vida positiva" {
    assert.notThat(verdulero.estaMuerto())
  }

  test "no puede actuar si no pasaron suficientes ticks" {
    assert.notThat(verdulero.puedeActuar())
  }

  test "puede actuar cuando se acumulan suficientes ticks" {
    verdulero.intervaloDeAccion().times({ i => verdulero.actualizar() })
    assert.that(verdulero.puedeActuar())
  }

  test "no dispara si no hay ningún zombie en su fila" {
    mapaDeTest.agregarZombie(new ZombieComun(position = game.at(8, 4), mapa = mapaDeTest))
    100.times({ i => verdulero.actualizar() })
    assert.equals([], mapaDeTest.proyectiles())
  }

  test "dispara cuando hay un zombie adelante en su fila" {
    mapaDeTest.agregarZombie(new ZombieComun(position = game.at(8, 3), mapa = mapaDeTest))
    100.times({ i => verdulero.actualizar() })
    assert.notThat(mapaDeTest.proyectiles().isEmpty())
  }

  test "no dispara a un zombie que quedó detrás suyo" {
    mapaDeTest.agregarZombie(new ZombieComun(position = game.at(1, 3), mapa = mapaDeTest))
    100.times({ i => verdulero.actualizar() })
    assert.equals([], mapaDeTest.proyectiles())
  }
}

describe "Panadero - lógica de dominio" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const panadero = new Panadero(
    position = game.at(2, 5),
    vida = 300,
    costo = 5,
    mapa = mapaDeTest,
    intervaloDeColocacion = 30
  )

  test "recibe un 30% menos de daño" {
    const vidaInicial = panadero.vida()
    panadero.recibirDanio(20)
    assert.equals(vidaInicial - 20 * 0.7, panadero.vida())
  }

  test "no está muerta si tiene vida positiva" {
    assert.notThat(panadero.estaMuerto())
  }

  test "muere cuando el daño reducido agota su vida" {
    panadero.recibirDanio(500)
    assert.that(panadero.estaMuerto())
  }

  test "actualizar no cambia la vida de una barrera pasiva" {
    panadero.actualizar()
    assert.equals(300, panadero.vida())
    assert.notThat(panadero.estaMuerto())
  }
}

describe "Vendecursos - lógica de dominio" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const pesos = new SistemaDePesos(pesosDisponibles = 0, pesosPorGeneracion = 0, intervaloDeGeneracion = 1000)
  const vendecursos = new Vendecursos(
    position = game.at(1, 2),
    vida = 100,
    costo = 50,
    mapa = mapaDeTest,
    intervaloDeColocacion = 30,
    intervaloDeAccion = 20,
    sistemaDePesos = pesos,
    pesosPorVenta = 25
  )

  test "no genera pesos antes de cumplir su intervalo de venta" {
    (vendecursos.intervaloDeAccion() - 1).times({ i => vendecursos.actualizar() })
    assert.equals(0, pesos.pesosDisponibles())
  }

  test "con el tiempo genera pesos de a una venta por vez" {
    200.times({ i => vendecursos.actualizar() })
    assert.that(pesos.pesosDisponibles() > 0)
    assert.equals(0, pesos.pesosDisponibles() % vendecursos.pesosPorVenta())
  }

  test "bloqueado por un inspector no genera pesos" {
    vendecursos.reaccionarAInspector(true)
    200.times({ i => vendecursos.actualizar() })
    assert.equals(0, pesos.pesosDisponibles())
  }

  test "vuelve a generar pesos cuando se levanta el bloqueo" {
    vendecursos.reaccionarAInspector(true)
    200.times({ i => vendecursos.actualizar() })
    vendecursos.reaccionarAInspector(false)
    200.times({ i => vendecursos.actualizar() })
    assert.that(pesos.pesosDisponibles() > 0)
  }

  test "muerto deja de generar pesos" {
    vendecursos.recibirDanio(vendecursos.vida())
    200.times({ i => vendecursos.actualizar() })
    assert.equals(0, pesos.pesosDisponibles())
  }
}

describe "Polimorfismo - actualizar() en defensas diferentes" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const verdulero = new Verdulero(
    position = game.at(2, 3),
    vida = 50,
    costo = 10,
    danio = 20,
    mapa = mapaDeTest,
    intervaloDeColocacion = 5,
    intervaloDeAccion = 10
  )
  const panadero = new Panadero(
    position = game.at(2, 5),
    vida = 300,
    costo = 5,
    mapa = mapaDeTest,
    intervaloDeColocacion = 30
  )

  test "todas las defensas reciben daño" {
    const defensas = [verdulero, panadero]
    defensas.forEach({ defensa => defensa.recibirDanio(10) })
    assert.equals(40, verdulero.vida())
    assert.equals(293, panadero.vida())
  }

  test "todas las defensas consultan si están muertas" {
    const defensas = [verdulero, panadero]
    assert.equals([false, false], defensas.map({ defensa => defensa.estaMuerto() }))
  }
}
