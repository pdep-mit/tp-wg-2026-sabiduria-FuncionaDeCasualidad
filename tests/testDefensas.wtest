import defensas.*
import zombies.*
import mapa.*


describe "Verdulero - lógica de dominio" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const verdulero = new Verdulero(
    position = game.at(2, 3),
    vida = 50,
    costo = 10,
    danio = 20,
    mapa = mapaDeTest,
    intervaloDeColocacion = 5,
    intervaloDeAccion = 10
  )

  test "comienza con la vida indicada" {
    assert.equals(50, verdulero.vida())
  }

  test "recibir daño reduce la vida" {
    verdulero.recibirDanio(15)
    assert.equals(35, verdulero.vida())
  }

  test "recibir daño múltiple acumula la reducción" {
    verdulero.recibirDanio(10)
    verdulero.recibirDanio(10)
    assert.equals(30, verdulero.vida())
  }

  test "muere cuando su vida llega a 0" {
    verdulero.recibirDanio(50)
    assert.that(verdulero.estaMuerto())
  }

  test "muere cuando su vida queda negativa" {
    verdulero.recibirDanio(999)
    assert.that(verdulero.estaMuerto())
  }

  test "no está muerta si tiene vida positiva" {
    assert.notThat(verdulero.estaMuerto())
  }

  test "no puede actuar si no pasaron suficientes ticks" {
    assert.notThat(verdulero.puedeActuar())
  }

  test "puede actuar cuando se acumulan suficientes ticks" {
    10.times({ i => verdulero.actualizar() })
    assert.that(verdulero.puedeActuar())
  }

  test "su costo es el indicado al construirlo" {
    assert.equals(10, verdulero.costo())
  }

  test "su posición es la indicada al construirlo" {
    assert.equals(game.at(2, 3), verdulero.position())
  }
}

describe "Panadero - lógica de dominio" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const panadero = new Panadero(
    position = game.at(2, 5),
    vida = 300,
    costo = 5,
    mapa = mapaDeTest,
    intervaloDeColocacion = 30
  )

  test "comienza con la vida indicada (alta para una barrera)" {
    assert.equals(300, panadero.vida())
  }

  test "recibe un 30% menos de daño" {
    panadero.recibirDanio(20)
    assert.equals(286, panadero.vida())
  }

  test "aguanta muchos golpes antes de morir" {
    21.times({ i => panadero.recibirDanio(20) })
    assert.notThat(panadero.estaMuerto())
    panadero.recibirDanio(20)
    assert.that(panadero.estaMuerto())
  }

  test "no está muerta si tiene vida positiva" {
    assert.notThat(panadero.estaMuerto())
  }

  test "muere cuando el daño reducido agota su vida" {
    panadero.recibirDanio(500)
    assert.that(panadero.estaMuerto())
  }

  test "su costo es barato" {
    assert.equals(5, panadero.costo())
  }

  test "actualizar no cambia la vida de una barrera pasiva" {
    panadero.actualizar()
    assert.equals(300, panadero.vida())
    assert.notThat(panadero.estaMuerto())
  }

  test "su posición es la indicada al construirlo" {
    assert.equals(game.at(2, 5), panadero.position())
  }
}

describe "Polimorfismo - actualizar() en defensas diferentes" {

  const mapaDeTest = new Mapa(filas = 9, columnas = 20)
  const verdulero = new Verdulero(
    position = game.at(2, 3),
    vida = 50,
    costo = 10,
    danio = 20,
    mapa = mapaDeTest,
    intervaloDeColocacion = 5,
    intervaloDeAccion = 10
  )
  const panadero = new Panadero(
    position = game.at(2, 5),
    vida = 300,
    costo = 5,
    mapa = mapaDeTest,
    intervaloDeColocacion = 30
  )

  test "todas las defensas entienden actualizar()" {
    const defensas = [verdulero, panadero]
    defensas.forEach({ defensa => defensa.actualizar() })
    assert.that(true)
  }

  test "todas las defensas reciben daño" {
    const defensas = [verdulero, panadero]
    defensas.forEach({ defensa => defensa.recibirDanio(10) })
    assert.equals(40, verdulero.vida())
    assert.equals(293, panadero.vida())
  }

  test "todas las defensas consultan si están muertas" {
    const defensas = [verdulero, panadero]
    assert.equals([false, false], defensas.map({ defensa => defensa.estaMuerto() }))
  }
}
