import controles.*
import motor.*
import mapa.*
import pesos.*
import defensas.*

describe "Controles - selección y colocación de defensas" {
  const mapaDeJuego = new Mapa(filas = 9, columnas = 20)
  const pesosDeJuego = new SistemaDePesos(
    pesosDisponibles = 100,
    pesosPorGeneracion = 25,
    intervaloDeGeneracion = 50
  )

  method initialize() {
    mapaDeJuego.crearCasilleros()
    motor.inicializar(mapaDeJuego, pesosDeJuego, null)
    controles.inicializar()
  }

  test "inicialmente no hay ninguna defensa seleccionada" {
    assert.equals(ningunaDefensa, controles.tipoDeDefensaSeleccionada())
  }

  test "sin defensa seleccionada, Enter no coloca nada ni cobra" {
    controles.colocarDefensaSeleccionada(3, 4)
    assert.equals([], mapaDeJuego.defensas())
    assert.equals(100, pesosDeJuego.pesosDisponibles())
  }

  test "hacer clic en un retrato del panel selecciona esa defensa" {
    controles.seleccionarDefensaEnPanel(game.at(7.5, 5.3))
    assert.equals(tipoVerdulero, controles.tipoDeDefensaSeleccionada())
    controles.seleccionarDefensaEnPanel(game.at(2, 5))
    assert.equals(tipoVerdulero, controles.tipoDeDefensaSeleccionada())
  }

  test "seleccionar defensa con teclas 1, 2 y 3" {
    controles.seleccionarDefensa(1)
    assert.equals(tipoVendecursos, controles.tipoDeDefensaSeleccionada())

    controles.seleccionarDefensa(2)
    assert.equals(tipoVerdulero, controles.tipoDeDefensaSeleccionada())

    controles.seleccionarDefensa(3)
    assert.equals(tipoPanadero, controles.tipoDeDefensaSeleccionada())
  }

  test "un número fuera de rango conserva la selección anterior" {
    controles.seleccionarDefensa(2)
    controles.seleccionarDefensa(7)
    assert.equals(tipoVerdulero, controles.tipoDeDefensaSeleccionada())
  }

  test "crearDefensaSeleccionada genera la instancia correspondiente en la fila y columna indicadas" {
    controles.seleccionarDefensa(2)
    const verdulero = controles.crearDefensaSeleccionada(3, 4)
    assert.notEquals(null, verdulero)
    assert.equals(game.at(4, 3), verdulero.position())
    assert.equals(100, verdulero.costo())

    controles.seleccionarDefensa(3)
    const panadero = controles.crearDefensaSeleccionada(1, 2)
    assert.notEquals(null, panadero)
    assert.equals(game.at(2, 1), panadero.position())
    assert.equals(500, panadero.vida())

    controles.seleccionarDefensa(1)
    const vendecursos = controles.crearDefensaSeleccionada(0, 0)
    assert.notEquals(null, vendecursos)
    assert.equals(game.at(0, 0), vendecursos.position())
  }

  test "el cursor se mueve con las flechas sin salir del mapa" {
    controles.moverCursor(cursor.position().up(1))
    controles.moverCursor(cursor.position().right(1))
    assert.equals(game.at(1, 1), cursor.position())
    controles.moverCursor(cursor.position().left(5))
    assert.equals(game.at(1, 1), cursor.position())
  }

  test "colocarDefensaSeleccionada delega la colocación al motor" {
    controles.seleccionarDefensa(2)
    controles.colocarDefensaSeleccionada(3, 4)
    assert.that(true)
  }
}
