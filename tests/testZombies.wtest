import wollok.game.*
import zombies.*
import mapa.*
import defensas.*
describe "Test de ZombieComun" {
    const unMapa = new Mapa(filas = 9, columnas = 20)
    const unZombie = new ZombieComun(position = game.at(10, 2), mapa = unMapa)
    const zombieGanador = new ZombieComun(position = game.at(0, 2), mapa = unMapa)
    const zombieAtaque = new ZombieComun(position = game.at(6, 2), mapa = unMapa)
    const zombie = new ZombieComun(position = game.at(10,2), mapa = unMapa)
test "Un zombie común recien creado inicia con 300 de vida" {
    unMapa.crearCasilleros()
    assert.equals(300, unZombie.vida())
}

test "Un zombie recibe daño correctamente restando su vida y activa la animación de golpe" {
    unMapa.crearCasilleros()
    unZombie.recibirDanio(100)
    assert.equals(200, unZombie.vida())
    assert.equals("zombieComun_recibe_ataque.png", unZombie.image())
}

test "El zombie llega a la casa cuando esta en la columna 0 y festeja" {
    unMapa.crearCasilleros()
    assert.that(zombieGanador.llegoALaCasa())
    zombieGanador.actualizar()
    assert.equals("zombieComun_gana.png", zombieGanador.image())
}

test "El zombie ataca desde la casilla a la derecha y reduce la vida de la defensa en 10" {
    unMapa.crearCasilleros()
    const verdulero = new Verdulero(
        position = game.at(5,2),
        vida = 50,
        costo = 100,
        danio = 20,
        mapa = unMapa,
        intervaloDeColocacion = 10,
        intervaloDeAccion = 15
        )

    unMapa.colocarDefensa(verdulero, 2, 5)
    30.times({ i => zombieAtaque.actualizar() })
    assert.equals(40, verdulero.vida())
    
}

test "Un zombie esta muerto cuando su vida llego a 0" {
    unMapa.crearCasilleros()
    zombie.recibirDanio(300)
    assert.that(zombie.estaMuerto())
}

}

describe "Test de ZombieAlbanil" {
    const unMapa = new Mapa(filas = 9, columnas = 20)
    test "Un zombie albañil inicia con 600 de vida" {
        const zombie = new ZombieAlbanil(position = game.at(10,2), mapa = unMapa)
        assert.equals(600, zombie.vida())
    }

    test "Un zombie albañil recibe daño correctamente" {
        const zombie = new ZombieAlbanil(position = game.at(10,2), mapa = unMapa)
        zombie.recibirDanio(200)
        assert.equals(400, zombie.vida())
        assert.equals("zombieAlbanil_recibe_ataque.png", zombie.image())
    }

    test "Un zombie albañil muere cuando pierde toda su vida" {
        const zombie = new ZombieAlbanil(position = game.at(10,2), mapa = unMapa)
        zombie.recibirDanio(600)
        assert.that(zombie.estaMuerto())
    }

    test "Un zombie albañil reconoce cuando llega a la casa" {
        const zombie = new ZombieAlbanil(position = game.at(0,2), mapa = unMapa)
        zombie.actualizar()
        assert.that(zombie.llegoALaCasa())
        assert.equals("zombieAlbanil_gana.png", zombie.image())
    }
}

