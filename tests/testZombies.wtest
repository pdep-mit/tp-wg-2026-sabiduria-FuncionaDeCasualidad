import wollok.game.*
import zombies.*
import mapa.*
import defensas.*
import motor.*
describe "Test de ZombieComun" {
    const unMapa = new Mapa(filas = 9, columnas = 20)
    
    method initialize() {
        unMapa.crearCasilleros()
    }
test "Un zombie común recien creado inicia con 100 de vida" {
    const zombie = new ZombieComun(position = game.at(10, 2), mapa = unMapa)
    assert.equals(100, zombie.vida())
}

test "Un zombie común recibe danio correctamente restando su vida y activa la animación de golpe" {
    const zombie = new ZombieComun(position = game.at(10, 2), mapa = unMapa)
    zombie.recibirDanio(40)
    assert.equals(60, zombie.vida())
    assert.equals("zombieComun_recibe_ataque.png", zombie.image())
}

test "Un zombie común llega a la casa cuando esta en la columna 0 y festeja" {
    const zombieGanador = new ZombieComun(position = game.at(0, 2), mapa = unMapa)
    assert.that(zombieGanador.llegoALaCasa())
    zombieGanador.actualizar()
    assert.equals("zombieComun_gana.png", zombieGanador.image())
}

test "Un zombie común ataca desde la casilla a la derecha y reduce la vida de la defensa en 10" {
    const zombieAtaque = new ZombieComun(position = game.at(6, 2), mapa = unMapa)
    const verdulero = new Verdulero(
        position = game.at(5,2),
        vida = 50,
        costo = 100,
        danio = 20,
        mapa = unMapa,
        intervaloDeColocacion = 10,
        intervaloDeAccion = 15
        )

    unMapa.colocarDefensa(verdulero, 2, 5)
    30.times({ i => zombieAtaque.actualizar() })
    assert.equals(40, verdulero.vida())
    
}

test "Un zombie común esta muerto cuando su vida llego a 0" {
    const zombie = new ZombieComun(position = game.at(10, 2), mapa = unMapa)
    zombie.recibirDanio(100)
    assert.that(zombie.estaMuerto())
}

}

describe "Test de ZombieAlbanil" {
    const unMapa = new Mapa(filas = 9, columnas = 20)

    method initialize() {
        unMapa.crearCasilleros()
    }
    test "Un zombie albanil inicia con 300 de vida" {
        const zombie = new ZombieAlbanil(position = game.at(10, 2), mapa = unMapa)
        assert.equals(300, zombie.vida())
    }

    test "Un zombie albanil recibe danio correctamente restando su vida y activa la animación de golpe" {
        const zombie = new ZombieAlbanil(position = game.at(10, 2), mapa = unMapa)
        zombie.recibirDanio(200)
        assert.equals(100, zombie.vida())
        assert.equals("zombieAlbanil_recibe_ataque.png", zombie.image())
    }

    test "Un zombie albanil esta muerto cuando su vida llego a 0" {
        const zombie = new ZombieAlbanil(position = game.at(10, 2), mapa = unMapa)
        zombie.recibirDanio(300)
        assert.that(zombie.estaMuerto())
    }

    test "Un zombie albanil reconoce cuando llega a la casa" {
        const zombie = new ZombieAlbanil(position = game.at(0, 2), mapa = unMapa)
        zombie.actualizar()
        assert.that(zombie.llegoALaCasa())
        assert.equals("zombieAlbanil_gana.png", zombie.image())
    }
}

describe "Test de ZombieMotoquero" {
    const unMapa = new Mapa(filas = 9, columnas = 20)

    method initialize() {
        unMapa.crearCasilleros()
    }
    test "Un zombie motoquero inicia con 100 de vida y con su imagen en moto" {
        const zombie = new ZombieMotoquero(position = game.at(10, 2), mapa = unMapa)
        assert.equals(100, zombie.vida())
        assert.equals("zombieMotoquero.png", zombie.image())
    }
    
    test "Un zombie motoquero no recibe danio mientras esta en la moto" {
        const zombie = new ZombieMotoquero(position = game.at(10, 2), mapa = unMapa)
        zombie.recibirDanio(60)
        assert.equals(100, zombie.vida())
        assert.equals("zombieMotoquero.png", zombie.image())
    }

    test "Al atacar una defensa baja de la moto, pasa a modo comun y luego recibe danio" {
        const zombie = new ZombieMotoquero(position = game.at(6, 2), mapa = unMapa)
        const verdulero = new Verdulero(
            position = game.at(5, 2),
            vida = 50,
            costo = 100,
            danio = 20,
            mapa = unMapa,
            intervaloDeColocacion = 10,
            intervaloDeAccion = 15
        )

        unMapa.colocarDefensa(verdulero, 2, 5)
        zombie.actualizar()
        assert.equals("zombieComun1.png", zombie.imagenZombieActual())
    }
    
    test "Un zombie motoquero esta muerto cuando su vida llego a 0 estando en modo comun" {
        const zombie = new ZombieMotoquero(position = game.at(10, 2), mapa = unMapa)
        zombie.bajarDeLaMoto()
        zombie.recibirDanio(100)
        assert.that(zombie.estaMuerto())
    }

    test "Un zombie motoquero reconoce cuando llega a la casa en moto" {
        const zombie = new ZombieMotoquero(position = game.at(0, 2), mapa = unMapa)
        zombie.actualizar()
        assert.that(zombie.llegoALaCasa())
        assert.equals("zombieMotoquero_gana.png", zombie.image())
    }
}

describe "Test de ZombieInspector" {
    const unMapa = new Mapa(filas = 9, columnas = 20)

    method initialize() {
        unMapa.crearCasilleros()
    }
    test "Un zombie inspector inicia con 100 de vida" {
        const zombie = new ZombieInspector(position = game.at(10, 2), mapa = unMapa)
        assert.equals(100, zombie.vida())
    }
    
    test "Un zombie inspector se identifica como inspector" {
        const zombie = new ZombieInspector(position = game.at(10, 2), mapa = unMapa)
        assert.that(zombie.esInspector())
    }
    
    test "Un zombie inspector recibe danio correctamente restando su vida y activa la animación de golpe" {
        const zombie = new ZombieInspector(position = game.at(10, 2), mapa = unMapa)
        zombie.recibirDanio(40)
        assert.equals(60, zombie.vida())
        assert.equals("zombieInspector_recibe_ataque.png", zombie.image())
    }
    
    test "Un zombie inspector esta muerto cuando su vida llego a 0" {
        const zombie = new ZombieInspector(position = game.at(10, 2), mapa = unMapa)
        zombie.recibirDanio(100)
        assert.that(zombie.estaMuerto())
    }
    
    test "Un zombie comun no se identifica como inspector" {
        const zombie = new ZombieComun(position = game.at(10, 2), mapa = unMapa)
        assert.notThat(zombie.esInspector())
    }
}

