import wollok.game.*
import mapa.*
import pesos.*
import motor.*
import controles.*
import oleadas.*

program ConurbanoVsZombies {
	game.title("Grupo: FuncionaDeCasualidad | Conurbano vs. Zombies")
	game.width(9)
	game.height(6)
	game.cellSize(100)

	const milisegundosPorTick = 1000 / 60
	const mapaDeJuego = new Mapa(filas = game.height() - 1, columnas = game.width())
	const pesosDeJuego = new SistemaDePesos(
		pesosDisponibles = 200,
		pesosPorGeneracion = 25,
		intervaloDeGeneracion = 60
	)
	const generador = new GeneradorDeZombies(mapa = mapaDeJuego, sistemaDePesos = pesosDeJuego)

	motor.inicializar(mapaDeJuego, pesosDeJuego, generador)
	controles.inicializar()
	game.addVisual(new PanelSuperior(position = game.at(0, 5)))
	const indicadores = [
		new IndicadorDeVelocidad(position = game.at(2, 5), motorDeJuego = motor),
		new IndicadorDePesos(position = game.at(0, 5), sistemaDePesos = pesosDeJuego, divisor = 1000, lugar = 0),
		new IndicadorDePesos(position = game.at(1, 5), sistemaDePesos = pesosDeJuego, divisor = 100, lugar = 1),
		new IndicadorDePesos(position = game.at(1, 5), sistemaDePesos = pesosDeJuego, divisor = 10, lugar = 2),
		new IndicadorDePesos(position = game.at(1, 5), sistemaDePesos = pesosDeJuego, divisor = 1, lugar = 3),
		new IndicadorDePartida(position = game.at(3, 5), motorDeJuego = motor),
		new IndicadorDeSeleccion(position = game.at(6, 5))
	]
	indicadores.forEach({ indicador => game.addVisual(indicador) })

	game.onTick(milisegundosPorTick, "actualizarMotor", { => motor.actualizarSegunVelocidad() })
	
	game.start()
}
