import wollok.game.*
import inicio.*
import fondo.*
import mapa.*
import pesos.*
import motor.*
import controles.*
import zombies.*

program ConurbanoVsZombies {
	game.title("Grupo: FuncionaDeCasualidad | Conurbano vs. Zombies")
	game.width(9)
	game.height(6) // Cinco filas jugables y una franja de indicadores.
	game.cellSize(100)
	
	fondo.iniciar()

	const milisegundosPorTick = 100
	const mapaDeJuego = new Mapa(filas = game.height() - 1, columnas = game.width())
	const pesosDeJuego = new SistemaDePesos(
		pesosDisponibles = 100,
		pesosPorGeneracion = 25,
		intervaloDeGeneracion = 50
	)
	const generador = new GeneradorDeZombies(
		mapa = mapaDeJuego,
		intervaloDeAparicion = 100
	)

	motor.iniciar(mapaDeJuego, pesosDeJuego, generador)
	controles.iniciar(motor)
	const indicadores = [
		new IndicadorDePesos(position = game.at(1, 5), sistemaDePesos = pesosDeJuego),
		new IndicadorDePartida(position = game.at(4, 5), motorDeJuego = motor),
		new IndicadorDeSeleccion(position = game.at(7, 5), controlesDeJuego = controles)
	]
	indicadores.forEach({ indicador => game.addVisual(indicador) })

	game.onTick(milisegundosPorTick, "actualizarMotor", { => motor.actualizar() })
	
	configuraciones.iniciarZombie(mapaDeJuego)
	
	game.start()
}
